# ─────────────────────────────────────────────────────────────
#  SocraMetry 環境変数テンプレート
#
#  ローカル開発 (apps/function の local.ts) 用に、このファイルをコピーして
#  .env を作成してください（.env はコミットされません）。
#      Copy-Item .env.example .env
#
#  本番の apps/function では、これらは enebular クラウド実行環境の
#  envVars として設定します（→ docs/deployment.md §3.2）。
# ─────────────────────────────────────────────────────────────

# ── OrcaRouter（必須）─────────────────────────────────────────
# https://www.orcarouter.ai のダッシュボードで発行したキー（sk-orca- で始まる）
# ★ バックエンドにのみ配置すること。フロントエンドには絶対に置かない
ORCAROUTER_API_KEY=sk-orca-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ── 用途別モデル（provider/model 形式）────────────────────────
# 具体的な ID は GET /v1/models で確認して確定する（未決事項 Q-1）
MODEL_DIAGNOSER=anthropic/claude-sonnet-4.6
MODEL_QUESTIONER=openai/gpt-4o-mini
MODEL_JUDGE=openai/gpt-4o-mini
MODEL_FALLBACK=google/gemini-2.5-flash

# ── enebular データストア（必須）──────────────────────────────
# enebular コンソールでテーブルを作成して払い出される UUID を設定する。
# 認証情報はクラウド実行環境が自動注入するため、キーの設定は不要
# （実行環境の connectDataStore を有効にすること）。
DS_TABLE_SESSIONS=00000000-0000-0000-0000-000000000000
DS_TABLE_SECRETS=00000000-0000-0000-0000-000000000000
DS_TABLE_REPORTS=00000000-0000-0000-0000-000000000000
DS_TABLE_ORG_DIRECTORY=00000000-0000-0000-0000-000000000000
DS_TABLE_MEMBER_STATS=00000000-0000-0000-0000-000000000000
DS_TABLE_ASSIGNMENTS=00000000-0000-0000-0000-000000000000
DS_TABLE_QUESTION_BANK=00000000-0000-0000-0000-000000000000
DS_TABLE_OPS_LOGS=00000000-0000-0000-0000-000000000000

# @uhuru/enebular-sdk のログレベル: ERROR | WARN | INFO | DEBUG | TRACE
LOG_LEVEL=INFO

# ── 認証（BtoB / FR-31）───────────────────────────────────────
# OIDC もしくは GitHub OAuth。導入企業の要件に応じて選択（未決 Q-9）
AUTH_ISSUER=https://github.com
AUTH_CLIENT_ID=change-me
AUTH_CLIENT_SECRET=change-me
# セッション Cookie(JWT) の署名鍵（openssl rand -hex 32 等で生成）
SESSION_JWT_SECRET=change-me

# ── アプリケーション設定 ──────────────────────────────────────
# 1 セッションあたりの LLM トークン上限（NFR-C1）
SESSION_TOKEN_BUDGET=80000
# セッション作成のレート制限（回/時/メンバー, NFR-O3）
RATE_LIMIT_SESSIONS_PER_HOUR=10
# CORS 許可オリジン。フロントとバックが別オリジンのため完全一致で指定する
# （ワイルドカードは Cookie 送信と併用できない / NFR-S8）
ALLOWED_ORIGIN=http://localhost:3000
# 運用ログをデータストアに書くか（既定 false: アクセス枠を消費するため）
OPS_LOG_ENABLED=false

# ── フロントエンド (apps/web) ─────────────────────────────────
# enebular の HTTP トリガー URL。ローカル開発では local.ts のポート
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# ─────────────────────────────────────────────────────────────
#  以下はローカルには不要。GitHub Actions の Secrets / Variables に設定する
#  （→ docs/deployment.md §4）
#
#  Secrets:   ENEBULAR_ACCESS_KEY / ENEBULAR_SECRET_KEY
#  Variables: ENEBULAR_PROJECT_ID / ENEBULAR_CLOUD_ID /
#             ENEBULAR_FILE_ASSET_ID / HTTP_TRIGGER_URL
# ─────────────────────────────────────────────────────────────
