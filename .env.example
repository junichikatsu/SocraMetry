# ─────────────────────────────────────────────────────────────
#  SocraMetry 環境変数テンプレート（v0.1）
#
#  ローカル開発 (apps/function の local.ts) 用に、このファイルを
#  リポジトリのルートにコピーして .env を作成してください（コミットされません）。
#      Copy-Item .env.example .env
#  pnpm dev が --env-file-if-exists でルートの .env を読み込みます。
#  ★ 置き場所はリポジトリのルート。apps/function 直下ではありません
#
#  本番では enebular クラウド実行環境の envVars として設定します
#  （→ docs/deployment.md §3.3）。PORT を除く 29 個がそのまま対象です。
#
#  ★ MOCK_MODE=true が消すのは LLM 呼び出しだけです（ADR-014）。
#    データストアは実行環境が注入する接続情報を使うため、ローカルで API を
#    通しで叩くには enebular のデータストアに接続できる状態が必要です。
#    MOCK モードでの導線確認は自動テストで行います（apps/function/src/api.test.ts）。
# ─────────────────────────────────────────────────────────────

# ── MOCK モード（ADR-014）─────────────────────────────────────
# true にすると LLM を一切呼ばず固定応答を返す。
# 開発・テスト・デモの保険。開発中の LLM 課金がゼロになる。
MOCK_MODE=true

# ── OrcaRouter（MOCK_MODE=false のとき必須）───────────────────
# https://www.orcarouter.ai のダッシュボードで発行したキー（sk-orca- で始まる）
# ★ バックエンドにのみ配置すること。フロントエンドには絶対に置かない
ORCAROUTER_API_KEY=sk-orca-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ── モデル出し分け（F03）──────────────────────────────────────
# 診断は 1 セッション 1 回だけ。ここに高品質モデルを使う。
# 出題・判定は 10 回以上呼ばれる。ここを安価にすると効果が 10 倍で効く。
# 具体的な ID は GET /v1/models で確認して確定する（未決 Q-1）
MODEL_DIAGNOSER=anthropic/claude-sonnet-4.6
MODEL_QUESTIONER=openai/gpt-4o-mini
MODEL_JUDGE=openai/gpt-4o-mini
MODEL_FALLBACK=google/gemini-2.5-flash

# ── 出力トークン上限（F04 / docs/cost-model.md §3）────────────
MAX_TOKENS_DIAGNOSER=800
MAX_TOKENS_HINTER=200
MAX_TOKENS_QUESTIONER=500
MAX_TOKENS_JUDGE=300
MAX_TOKENS_REVEALER=600
MAX_TOKENS_REPORTER=800

# 1 セッションあたりの LLM トークン上限（入出力合計 / NFR-C1）
SESSION_TOKEN_BUDGET=80000
# コストログの円換算レート（F11）
USD_JPY_RATE=150

# ── enebular データストア（必須）──────────────────────────────
# enebular コンソールでテーブルを作成して払い出される UUID を設定する。
# 認証情報はクラウド実行環境が自動注入するため、キーの設定は不要
# （実行環境の connectDataStore を有効にすること）。
DS_TABLE_USERS=00000000-0000-0000-0000-000000000000
DS_TABLE_SESSIONS=00000000-0000-0000-0000-000000000000
DS_TABLE_SECRETS=00000000-0000-0000-0000-000000000000
DS_TABLE_REPORTS=00000000-0000-0000-0000-000000000000
DS_TABLE_OPS_LOGS=00000000-0000-0000-0000-000000000000

# LLM 呼び出しログを ops_logs テーブルに書くか（false なら標準ログのみ）
# ★ v0.1 は実測コスト表(F11)を作るため true。1 セッションあたり約 14 アクセスを消費する
OPS_LOG_ENABLED=true

# @uhuru/enebular-sdk のログレベル: ERROR | WARN | INFO | DEBUG | TRACE
# ★ DEBUG 以上では入力内容がログに出うる。本番では INFO 以下にすること
LOG_LEVEL=INFO

# ── 認証（v0.1 の簡易実装 / F15）──────────────────────────────
# セッション Cookie(JWT) の署名鍵（openssl rand -hex 32 等で生成）
SESSION_JWT_SECRET=change-me
# サインアップに必要な招待コード。公開URLに無制限の登録を置かないため
# （LLM コストの流出防止も兼ねる / docs/security.md §5）
INVITE_CODE=change-me

# ── アプリケーション設定 ──────────────────────────────────────
# セッション作成のレート制限（回/時/ユーザー, NFR-O3）
RATE_LIMIT_SESSIONS_PER_HOUR=10

# ── ゲート遷移の待ち時間（FR-07 / 未決 Q-3・Q-4）─────────────
# 確定を待つと実装が始まらないため、仮の値で先に実装している。
# 実測で外れても直すのは設定 1 行。デモ用プリセットは 60000 / 300000。
#   Gate A → B: ヒント Lv3 開放後にこの時間が経過したら自動で設問へ
GATE_A_TIMEOUT_MS=300000
#   Gate B → C: セッション開始からこの時間が経過したら解説を解放
GATE_B_TIMEOUT_MS=1800000
# Gate B の段階数（既定 5）。デモで 3 に絞れる（roadmap.md 削る順序 #4）
DEMO_MAX_STAGES=5

# ── 除外語リスト（FR-11）──────────────────────────────────────
# 自社の社名・製品名をカンマ区切りで登録すると、完全一致で伏せる。
# ★ 顧客名などの固有名詞は正規表現では検出できない。ここに登録したものだけが消える
#   （組織単位の辞書は FR-41 / v0.2）
MASK_WORDS=

# ★ ここまでが enebular クラウド実行環境の envVars に設定する 29 個です。
#   HTTP トリガーのパス（例 /socrametry）を設定する変数はありません。
#   アプリ側が先頭セグメントを問わずルーティングするため不要です（ADR-009）。

# ローカル起動時のポート（本番では実行環境が処理するため envVars には不要）
PORT=8787

# ─────────────────────────────────────────────────────────────
#  フロントエンドの環境変数はありません。
#  関数から同一オリジンで配信するため、API は相対パス /v1/... で呼べます
#  （ADR-012）。CORS 設定も不要です。
#
#  GitHub Actions の Secrets / Variables（→ docs/deployment.md §4）
#    Secrets:   ENEBULAR_ACCESS_KEY / ENEBULAR_SECRET_KEY
#    Variables: ENEBULAR_PROJECT_ID / ENEBULAR_CLOUD_ID /
#               ENEBULAR_FILE_ASSET_ID / HTTP_TRIGGER_URL
#  ★ ORCAROUTER_API_KEY は CI に置きません。enebular コンソールで管理します
# ─────────────────────────────────────────────────────────────
